{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    /* Output Settings */
    "outDir": "./dist",
    "rootDir": "./src",
    /* Environment */
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    /* Compatibility */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,
    /* Source Maps */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "jsx": "react-jsx"
  },
  "ts-node": {
    "esm": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}